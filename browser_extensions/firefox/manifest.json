{
  "manifest_version": 3,
  "name": "Phishing Detector",
  "version": "1.0.0",
  "description": "Real-time phishing detection for Gmail",
  "author": "Liron Nyambu (github.com/lilrawn)",
  "homepage_url": "https://github.com/lilrawn/phishing-detection-nlp",
  "browser_specific_settings": {
    "gecko": {
      "id": "phishing-detector@lironnyambu.dev",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:9877/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "match_about_blank": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
