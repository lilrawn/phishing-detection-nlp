# Python virtual environment
venv/
env/
ENV/
venv.bak/
.virtualenvs/
*.pyc
__pycache__/

# Build output (generated by build.py / desktop_app/installers/*.py -- the
# .spec files bake in this machine's absolute paths, so they're not
# portable to a fresh clone either)
dist/
desktop_app/build/
desktop_app/dist/
desktop_app/Output/
desktop_app/*.spec
.build_tmp/

# Data files (too large for git)
data/raw/*.csv
data/raw/*.tar.bz2
data/raw/*.zip
data/raw/*.gz
data/raw/Mail-SpamAssassin-3.4.6/
data/raw/spamassassin_corpus/
data/processed/*.csv
data/processed/*.db
data/processed/*.pkl

# Database
*.db
*.db.bak
*.db-journal
*.sqlite
*.sqlite3

# macOS AppleDouble files (created when copying to non-HFS+ volumes, e.g.
# this project's exFAT external drive)
._*

# Models: the trained model + vectorizer are committed (not ignored) so the
# app works immediately after a fresh clone, without requiring a retrain.
# Only ignore formats this project doesn't actually produce.
models/*.h5
models/*.joblib

# Results
results/*.csv
results/*.png
results/*.jpg
results/*.pdf
!results/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Logs
logs/
*.log

# Environment variables
.env
